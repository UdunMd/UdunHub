--[[
    SCRIPT AUTO WALK - SLIME RNG
    Menggunakan WindUI Library
    Fitur:
    - Auto Walk (berjalan otomatis)
    - Pengaturan Kecepatan (Speed)
    - Pilihan Arah (Forward/Backward/Left/Right)
    - Toggle UI dengan tombol Insert
--]]

-- Load WindUI Library
local WindUI = loadstring(game:HttpGet('https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/main_example.lua'))()

-- Variabel untuk auto walk
local autoWalkEnabled = false
local walkDirection = "Forward" -- Forward, Backward, Left, Right
local walkSpeed = 16
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- Fungsi untuk update character reference
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
end)

-- Fungsi untuk mendapatkan arah gerakan
local function getMoveDirection()
    local camera = workspace.CurrentCamera
    local cf = camera.CFrame
    
    if walkDirection == "Forward" then
        return cf.LookVector
    elseif walkDirection == "Backward" then
        return -cf.LookVector
    elseif walkDirection == "Left" then
        return -cf.RightVector
    elseif walkDirection == "Right" then
        return cf.RightVector
    end
    return Vector3.new(0, 0, 0)
end

-- Fungsi untuk toggle auto walk
local function toggleAutoWalk()
    autoWalkEnabled = not autoWalkEnabled
    
    if autoWalkEnabled then
        humanoid.WalkSpeed = walkSpeed
        
        -- Loop untuk auto walk
        spawn(function()
            while autoWalkEnabled do
                if humanoid and humanoid.Parent then
                    local moveDir = getMoveDirection()
                    humanoid:Move(moveDir, true)
                end
                task.wait()
            end
        end)
    else
        if humanoid then
            humanoid:Move(Vector3.new(0, 0, 0), false)
        end
    end
end

-- Update kecepatan saat value berubah
local function setWalkSpeed(value)
    walkSpeed = value
    if autoWalkEnabled and humanoid then
        humanoid.WalkSpeed = walkSpeed
    end
end

-- Membuat Window utama
local MainWindow = WindUI:Window({
    Title = "Slime RNG Auto Walk",
    SubTitle = "Auto Walk Script",
    Icon = "rbxassetid://6031093677"
})

-- Tab untuk Auto Walk
local AutoWalkTab = MainWindow:Tab({
    Title = "Auto Walk"
})

-- Section utama
local MainSection = AutoWalkTab:Section({
    Title = "Pengaturan Auto Walk"
})

-- Toggle untuk mengaktifkan auto walk
MainSection:Toggle({
    Title = "Auto Walk",
    Description = "Aktifkan/Nonaktifkan auto walk",
    Callback = function(state)
        if state then
            toggleAutoWalk()
        else
            toggleAutoWalk()
        end
    end
})

-- Dropdown untuk memilih arah
MainSection:Dropdown({
    Title = "Arah Jalan",
    Description = "Pilih arah gerakan karakter",
    Values = {"Forward", "Backward", "Left", "Right"},
    Callback = function(value)
        walkDirection = value
    end
})

-- Slider untuk mengatur kecepatan
MainSection:Slider({
    Title = "Kecepatan Jalan",
    Description = "Atur kecepatan berjalan (16 = normal)",
    Min = 16,
    Max = 100,
    Default = 16,
    Callback = function(value)
        setWalkSpeed(value)
    end
})

-- Section informasi
local InfoSection = AutoWalkTab:Section({
    Title = "Informasi"
})

InfoSection:Label({
    Title = "Tekan Insert untuk membuka/tutup UI"
})

InfoSection:Label({
    Title = "Status: " .. (autoWalkEnabled and "Aktif" or "Nonaktif")
})

-- Hotkey untuk membuka/menutup UI
local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Insert then
        MainWindow:Toggle()
    end
end)

-- Notifikasi saat script dijalankan
MainWindow:Notification({
    Title = "Success",
    Description = "Auto Walk Script Loaded!",
    Duration = 3
})
