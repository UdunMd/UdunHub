local function GetWindowSize()
    if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
        return UDim2.new(0.7, 0, 0.8, 0)
    else
        return UDim2.new(0, 480, 0, 680)
    end
end

local function ToggleUI()
    if IsAnimating then return end
    IsAnimating = true
    IsOpen = not IsOpen
    TweenService:Create(ToggleIcon, TWEEN_TOGGLE_OPEN, {Rotation = IsOpen and 180 or 0}):Play()
    
    if IsOpen then
        TweenService:Create(Blur, TweenInfo.new(0.6), {Size = 24}):Play()
        TweenService:Create(Glow, TweenInfo.new(0.6), {Intensity = CurrentTheme.GlowIntensity * 0.8}):Play()
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        local t = TweenService:Create(MainFrame, TWEEN_TOGGLE_OPEN, {Size = GetWindowSize()})
        t:Play()
        t.Completed:Wait()
        
        -- Pulsing animation on title
        TweenService:Create(Title, TWEEN_ELASTIC, {TextSize = 26}):Play()
        task.wait(0.3)
        TweenService:Create(Title, TWEEN_QUINT, {TextSize = 24}):Play()
    else
        TweenService:Create(Blur, TweenInfo.new(0.5), {Size = 0}):Play()
        TweenService:Create(Glow, TweenInfo.new(0.5), {Intensity = 0}):Play()
        local t = TweenService:Create(MainFrame, TWEEN_TOGGLE_CLOSE, {Size = UDim2.new(0, 0, 0, 0)})
        t:Play()
        t.Completed:Wait()
        if not IsOpen then
            MainFrame.Visible = false
        end
        UdunHub:Notify("📦 SYSTEM", "Minimized to tray.", 2)
    end
    IsAnimating = false
end

