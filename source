local WMacLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Wicikk/WMacLib/main/WMacLib.lua"))()
local Window = WMacLib:Window({
    Title = "Script Manager",
    Subtitle = "Speed Control",
    Size = UDim2.fromOffset(500, 400),
    AcrylicBlur = true,
    Theme = "Dark"
})

-- Buat tab utama
local MainTab = Window:Tab({
    Name = "Settings",
    Icon = "settings"
})

-- Buat section untuk speed
local SpeedSection = MainTab:Section({
    Side = "Left"
})

-- Slider untuk mengatur kecepatan
local SpeedSlider = SpeedSection:Slider({
    Name = "Kecepatan Script",
    Default = 16,
    Minimum = 1,
    Maximum = 100,
    Precision = 0,
    DisplayMethod = "Value",
    Suffix = "x",
    Callback = function(value)
        -- Terapkan kecepatan ke script utama
        game:GetService("RunService").RenderStepped:Wait()
        local runService = game:GetService("RunService")
        
        -- Contoh implementasi: mempercepat/slowdown loop
        if _G.ScriptSpeed then
            _G.ScriptSpeed = value
        end
        
        print("Kecepatan diubah menjadi: " .. value .. "x")
        Window:Notify({
            Title = "Speed Updated",
            Description = "Kecepatan sekarang: " .. value .. "x",
            Lifetime = 2
        })
    end,
    onInputComplete = function(value)
        -- Event saat user selesai menggeser
        print("Speed finalized: " .. value .. "x")
    end
}, "ScriptSpeed")

-- Toggle untuk mengaktifkan speed control
local SpeedToggle = SpeedSection:Toggle({
    Name = "Aktifkan Speed Control",
    Default = true,
    Callback = function(state)
        if state then
            print("Speed control diaktifkan")
            -- Mulai effect speed
            _G.SpeedEnabled = true
        else
            print("Speed control dinonaktifkan")
            _G.SpeedEnabled = false
        end
    end
}, "SpeedToggle")

-- Label untuk menampilkan status
local StatusLabel = SpeedSection:Label({
    Text = "Status: Siap",
    Bold = false
}, "SpeedStatus")

-- Tombol reset
SpeedSection:Button({
    Name = "Reset ke Default (16x)",
    Callback = function()
        SpeedSlider:UpdateValue(16)
        Window:Notify({
            Title = "Reset",
            Description = "Kecepatan direset ke 16x",
            Lifetime = 2
        })
    end
})

-- Input untuk custom speed value
SpeedSection:Input({
    Name = "Custom Speed",
    Default = "",
    Placeholder = "Masukkan angka (1-100)",
    AcceptedCharacters = "Numeric",
    CharacterLimit = 3,
    Callback = function(text)
        local num = tonumber(text)
        if num and num >= 1 and num <= 100 then
            SpeedSlider:UpdateValue(num)
        elseif text ~= "" then
            Window:Notify({
                Title = "Error",
                Description = "Masukkan angka antara 1-100!",
                Lifetime = 2
            })
        end
    end
})

-- Contoh implementasi speed effect
local function ApplySpeedEffect()
    local RunService = game:GetService("RunService")
    local lastTime = tick()
    local currentSpeed = 16
    
    RunService.RenderStepped:Connect(function(deltaTime)
        if _G.SpeedEnabled then
            currentSpeed = WMacLib.Options["ScriptSpeed"]:GetValue() or 16
            local speedFactor = currentSpeed / 16
            -- Di sini Anda bisa menerapkan speed ke loop atau animasi
            -- Contoh: mempercepat game time atau loop
        end
    end)
end

-- Jadikan speed bisa diakses global
_G.SetScriptSpeed = function(speed)
    if WMacLib.Options["ScriptSpeed"] then
        WMacLib.Options["ScriptSpeed"]:UpdateValue(speed)
    end
end

_G.GetScriptSpeed = function()
    return WMacLib.Options["ScriptSpeed"] and WMacLib.Options["ScriptSpeed"]:GetValue() or 16
end

-- Jalankan effect
ApplySpeedEffect()
