-- Function to move to a position
local function moveToPosition(position)
    if not Humanoid or not RootPart then return false end
    
    -- Ensure Humanoid is still valid
    if Humanoid.Health <= 0 then
        return false
    end
    
    -- Tween movement or use Humanoid:MoveTo
    -- Using Humanoid:MoveTo is generally safer
    Humanoid:MoveTo(position)
    
    -- Optional: Auto-jump for obstacles
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not Humanoid or Humanoid.Health <= 0 then
            if connection then connection:Disconnect() end
            return
        end
        
        local dist = (RootPart.Position - position).Magnitude
        if dist < 5 then
            Humanoid:MoveTo(RootPart.Position) -- Stop moving
            if connection then connection:Disconnect() end
        end
        
        -- Attempt to jump if stuck (basic)
        if Humanoid.FloorMaterial == Enum.Material.Air and Humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
    
    return true
end

-- The Auto-Walk Loop
local function startAutoWalk()
    if WalkConnection then WalkConnection:Disconnect() end
    
    local nodesTable = getMapNodes()
    local nodeIndex = 1
    
    WalkConnection = RunService.RenderStepped:Connect(function()
        if not AutoWalkEnabled then return end
        
        -- Refresh character models
        Character = Player.Character
        if not Character or Character:FindFirstChild("Humanoid") == nil then
            Character = Player.CharacterAdded:Wait()
            Humanoid = Character:WaitForChild("Humanoid")
            RootPart = Character:WaitForChild("HumanoidRootPart")
            return
        end
        
        Humanoid = Character:FindFirstChild("Humanoid")
        RootPart = Character:FindFirstChild("HumanoidRootPart")
        if not Humanoid or Humanoid.Health <= 0 then return end
        
        local targetNode = nodesTable[nodeIndex]
        if not targetNode then
            -- Loop back to start
            nodeIndex = 1
            targetNode = nodesTable[nodeIndex]
        end
        
        local targetPos = targetNode.Pos
        local distance = (RootPart.Position - targetPos).Magnitude
        
        if distance < 7 then
            -- Reached node, move to next
            nodeIndex = nodeIndex + 1
        else
            -- Move towards node
            Humanoid:MoveTo(targetPos)
            
            -- Auto-collect nearby loot (Common requirement for Slime RNG)
            -- Attempts to touch proximity prompts or collect items automatically
