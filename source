--[[
    Script: Auto Farm Slime Rng + WindUI
    Fitur: Auto Click, Auto Upgrade, Stats Tracker
    Gunakan di Map: Slime Rng (Pastikan Karakter sudah spawn)
]]

-- Library Loader
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/main_example.lua"))()

-- Variables
local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local uis = game:GetService("UserInputService")

local farming = false
local autoUpgrade = false
local currentDelay = 0.1
local stats = {
    clicks = 0,
    slimes = 0
}

-- Fungsi untuk Simulasi Click / Attack (Ganti sesuai mekanik map)
local function performClick()
    if not farming then return end
    
    -- Method 1: Kirim remote event (jika map menggunakan remote)
    -- Cek apakah ada RemoteEvent yang umum
    local success, err = pcall(function()
        -- Ini adalah contoh umum untuk game RNG, sesuaikan dengan nama remote di map
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("ClickRequest") or 
                       game:GetService("ReplicatedStorage"):FindFirstChild("Attack")
        if remote then
            remote:FireServer()
        else
            -- Method 2: Simulasi mouse click ke tombol di layar (jika ada GUI Button)
            local screenGui = player.PlayerGui:FindFirstChild("MainGui")
            if screenGui then
                local button = screenGui:FindFirstChild("ClickButton", true)
                if button and button:IsA("TextButton") then
                    button:CaptureMouse()
                    button:InputBegin(Enum.UserInputType.MouseButton1)
                    task.wait(0.05)
                    button:InputEnd(Enum.UserInputType.MouseButton1)
                end
            end
        end
    end)
    
    if success then
        stats.clicks = stats.clicks + 1
        -- Update UI
        if window and window.updateStats then window:updateStats(stats) end
    end
end

-- Auto Click Loop
spawn(function()
    while true do
        if farming then
            performClick()
            task.wait(currentDelay)
        else
            task.wait(0.5)
        end
    end
end)

-- Auto Upgrade Loop (Upgrade otomatis saat uang cukup)
local function autoUpgradeLoop()
    while true do
        if autoUpgrade then
            -- Cari tombol upgrade (contoh: beli pickaxe, upgrade multiplier)
            local success, err = pcall(function()
                -- Ganti path ini sesuai UI map
                local upgradeFrame = player.PlayerGui:FindFirstChild("ShopGui")
                if upgradeFrame then
                    local upgradeButton = upgradeFrame:FindFirstChild("UpgradeButton", true)
                    if upgradeButton and upgradeButton:IsA("TextButton") and upgradeButton.Visible then
                        upgradeButton:CaptureMouse()
                        upgradeButton:InputBegin(Enum.UserInputType.MouseButton1)
                        task.wait(0.05)
                        upgradeButton:InputEnd(Enum.UserInputType.MouseButton1)
                        stats.slimes = stats.slimes + 1
                        if window and window.updateStats then window:updateStats(stats) end
                    end
                end
            end)
        end
        task.wait(1) -- Cek upgrade tiap detik
    end
end)
spawn(autoUpgradeLoop)

-- UI Creation using WindUI
local window = Library:createWindow({
    Text = "Slime Rng | Auto Farm Hub",
    Size = "400x480",
    ThemeColor = Color3.fromRGB(46, 204, 113) -- Hijau seperti slime
})

-- Tab: Main
local mainTab = window:addTab({
    Text = "Farm"
})

-- Tab: Settings
local settingsTab = window:addTab({
    Text = "Settings"
})

-- Tab: Stats
local statsTab = window:addTab({
    Text = "Stats"
})

-- Isi Tab Main
local mainSection = mainTab:addSection({
    Text = "Control Panel"
})

mainSection:addToggle({
    Text = "Auto Farm (Auto Click)",
    Default = false,
    Callback = function(v)
        farming = v
        if v then
            print("Auto Farm Started")
        else
            print("Auto Farm Stopped")
        end
    end
})

mainSection:addSlider({
    Text = "Click Delay (s)",
    Default = 0.1,
    Min = 0.05,
    Max = 2,
    Increase = 0.01,
    Callback = function(v)
        currentDelay = v
    end
})

mainSection:addButton({
    Text = "Click 1x (Manual)",
    Callback = function()
        performClick()
    end
})

local upgradeSection = mainTab:addSection({
    Text = "Auto Upgrade"
})

upgradeSection:addToggle({
    Text = "Auto Buy Upgrade",
    Default = false,
    Callback = function(v)
        autoUpgrade = v
    end
})

-- Isi Tab Settings
local delaySection = settingsTab:addSection({
    Text = "Advanced"
})

delaySection:addSlider({
    Text = "UI Animation Speed",
    Default = 0.3,
    Min = 0.1,
    Max = 1,
    Increase = 0.05,
    Callback = function(v)
        -- Untuk mengubah animasi UI jika perlu
    end
})

-- Isi Tab Stats
local statsSection = statsTab:addSection({
    Text = "Live Statistics"
})

-- Method custom untuk update stats
local statsLabel = statsSection:addLabel({
    Text = "Total Clicks: 0\nTotal Upgrades: 0"
})

-- Fungsi update stats yang bisa dipanggil dari manapun
function window:updateStats(s)
    if statsLabel then
        statsLabel:setText("Total Clicks: " .. s.clicks .. "\nTotal Upgrades: " .. s.slimes)
    end
end

-- Refresh stats setiap detik
spawn(function()
    while true do
        if window and window.updateStats then
            window:updateStats(stats)
        end
        task.wait(1)
    end
end)

-- Notifikasi awal
window:show()
Library:notification({
    Text = "Script Loaded!",
    Duration = 2,
    Type = "success"
})

-- Cleanup function (opsional)
game:GetService("Players").LocalPlayer.OnTeleport:Connect(function()
    farming = false
    if window and window.hide then window:hide() end
end)
