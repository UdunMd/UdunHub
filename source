-- Load WMacLib
local WMacLib = loadstring(game:HttpGetAsync("https://raw.githubusercontent.com/Wicikk/WMacLib/main/WMacLib.lua"))()

-- Fungsi untuk mencari item drop terdekat
local function getNearestDrop()
    local nearest = nil
    local shortestDistance = math.huge
    local character = game.Players.LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local hrp = character.HumanoidRootPart
    for _, v in pairs(workspace:GetDescendants()) do
        -- Sesuaikan "Drop" dengan nama sebenarnya item drop di game Slime Rng.
        -- Contoh: jika item adalah model dengan nama "Drop" atau memiliki part bernama "Handle"
        if v:IsA("BasePart") and v.Name == "Drop" then -- Ganti "Drop" dengan nama item yang benar!
            local distance = (hrp.Position - v.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearest = v
            end
        end
    end
    return nearest
end

-- Variabel untuk loop auto-walk
local autoWalkEnabled = false
local currentTarget = nil
local walkToConnection = nil

-- Fungsi untuk auto-walk ke item terdekat
local function startAutoWalkToDrops()
    if walkToConnection then walkToConnection:Disconnect() end
    walkToConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if not autoWalkEnabled then return end
        
        local target = getNearestDrop()
        if target and target.Parent then
            currentTarget = target
            local character = game.Players.LocalPlayer.Character
            if character and character:FindFirstChild("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
                local humanoid = character.Humanoid
                local hrp = character.HumanoidRootPart
                
                -- Posisi target + sedikit offset Y agar berjalan di atasnya
                local targetPos = target.Position + Vector3.new(0, 3, 0)
                local distance = (hrp.Position - target.Position).Magnitude
                
                if distance > 5 then
                    -- Berjalan menuju target
                    humanoid:MoveTo(targetPos)
                else
                    -- Jika sudah cukup dekat, hentikan dan tunggu drop berikutnya
                    humanoid:MoveTo(hrp.Position)
                    task.wait(0.5)
                end
            end
        else
            currentTarget = nil
        end
    end)
end

-- Membuat Window UI
local Window = WMacLib:Window({
    Title = "Slime Rng - Auto Item Drop",
    Subtitle = "Auto walk to nearest drop",
    Size = UDim2.fromOffset(450, 300),
    AcrylicBlur = true,
    ShowUserInfo = true,
    Keybind = Enum.KeyCode.RightControl,
})

-- Membuat Tab utama
local mainTab = Window:Tab({ Name = "Auto Farm", Icon = "lucide/droplet" })

-- Membuat Section
local mainSection = mainTab:Section({})

-- Toggle untuk menyalakan auto-walk
mainSection:Toggle({
    Name = "Auto Walk to Drop Items",
    Default = false,
    Callback = function(value)
        autoWalkEnabled = value
        if autoWalkEnabled then
            startAutoWalkToDrops()
            Window:Notify({
                Title = "Auto Walk",
                Description = "Auto walk ENABLED",
                Lifetime = 3
            })
        else
            if walkToConnection then
                walkToConnection:Disconnect()
                walkToConnection = nil
            end
            currentTarget = nil
            -- Hentikan karakter
            local character = game.Players.LocalPlayer.Character
            if character and character:FindFirstChild("Humanoid") then
                character.Humanoid:MoveTo(character.HumanoidRootPart.Position)
            end
            Window:Notify({
                Title = "Auto Walk",
                Description = "Auto walk DISABLED",
                Lifetime = 3
            })
        end
    end,
}, "AutoWalkToggle")

-- Label untuk menampilkan target saat ini
local targetLabel = mainSection:Label({
    Text = "Target: None"
})

-- Update label target setiap detik
task.spawn(function()
    while true do
        task.wait(1)
        if autoWalkEnabled and currentTarget and currentTarget.Parent then
            local distance = (game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and currentTarget.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            targetLabel:SetName("Target: " .. currentTarget.Name .. " | Distance: " .. math.floor(distance) .. " studs")
        elseif autoWalkEnabled then
            targetLabel:SetName("Target: Searching...")
        else
            targetLabel:SetName("Target: None (Disabled)")
        end
    end
end)

-- Button untuk refresh/scan ulang
mainSection:Button({
    Name = "Force Refresh Scan",
    Callback = function()
        local nearest = getNearestDrop()
        if nearest then
            Window:Notify({
                Title = "Scan Result",
                Description = "Nearest drop found: " .. nearest.Name,
                Lifetime = 3
            })
        else
            Window:Notify({
                Title = "Scan Result",
                Description = "No drop items found nearby!",
                Lifetime = 3
            })
        end
    end,
})

-- Slider untuk kecepatan berjalan (opsional)
local speedSlider = mainSection:Slider({
    Name = "Walk Speed",
    Default = 16,
    Minimum = 10,
    Maximum = 50,
    Precision = 0,
    DisplayMethod = "Value",
    Callback = function(value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = value
        end
    end,
})

-- Inisialisasi walk speed saat script dijalankan
task.spawn(function()
    while not game.Players.LocalPlayer.Character do task.wait() end
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        speedSlider:UpdateValue(char.Humanoid.WalkSpeed)
    end
end)
