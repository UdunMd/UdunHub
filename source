-- Inisialisasi walk speed saat character spawn
player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if char and char:FindFirstChild("Humanoid") then
        speedSlider:UpdateValue(char.Humanoid.WalkSpeed)
    end
    -- Jika auto walk sedang aktif saat respawn, restart
    if autoWalkEnabled then
        stopAutoWalk()
        task.wait(0.5)
        startAutoWalk()
    end
end)

-- Jika character sudah ada, set speed
if player.Character and player.Character:FindFirstChild("Humanoid") then
    speedSlider:UpdateValue(player.Character.Humanoid.WalkSpeed)
end

