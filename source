-- Animate Loading Bar
local function UpdateLoading(progress, message)
    LoadingFill:TweenSize(UDim2.new(progress, 0, 1, 0), "Out", "Linear", 0.1)
    LoadingPercent.Text = math.floor(progress * 100) .. "%"
    if message then
        LoadingText.Text = message
    end
end

-- Simulate loading progress
local steps = {
    {percent = 0.1, text = "Initializing UdunHub..."},
    {percent = 0.2, text = "Loading core modules..."},
    {percent = 0.3, text = "Fetching resources..."},
    {percent = 0.4, text = "Connecting to server..."},
    {percent = 0.5, text = "Loading UI components..."},
    {percent = 0.6, text = "Configuring settings..."},
    {percent = 0.7, text = "Loading features..."},
    {percent = 0.8, text = "Preparing menu..."},
    {percent = 0.9, text = "Finalizing..."},
    {percent = 1.0, text = "Welcome to UdunHub!"}
}

for i, step in ipairs(steps) do
    UpdateLoading(step.percent, step.text)
    wait(0.15)
end

-- Wait a bit before starting main script
wait(0.3)

