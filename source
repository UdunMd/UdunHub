-- LOADING SCREEN WITH UDUNHUB LOGO & ANIMATION (NO BAR)
local LoadingScreen = Instance.new("ScreenGui")
local Background = Instance.new("Frame")
local Logo = Instance.new("TextLabel")
local SubText = Instance.new("TextLabel")

LoadingScreen.Name = "LoadingScreen"
LoadingScreen.Parent = game.CoreGui
LoadingScreen.IgnoreGuiInset = true
LoadingScreen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Background
Background.Name = "Background"
Background.Parent = LoadingScreen
Background.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
Background.Size = UDim2.new(1, 0, 1, 0)

-- UdunHub Logo (dengan animasi)
Logo.Name = "Logo"
Logo.Parent = Background
Logo.BackgroundTransparency = 1
Logo.Position = UDim2.new(0.5, -150, 0.4, 0)
Logo.Size = UDim2.new(0, 300, 0, 60)
Logo.Font = Enum.Font.GothamBold
Logo.Text = "UDUNHUB"
Logo.TextColor3 = Color3.fromRGB(0, 200, 255)
Logo.TextSize = 48
Logo.TextScaled = true
Logo.TextStrokeTransparency = 0.5
Logo.TextStrokeColor3 = Color3.fromRGB(0, 100, 150)

-- Teks tambahan (tanpa bar)
SubText.Name = "SubText"
SubText.Parent = Background
SubText.BackgroundTransparency = 1
SubText.Position = UDim2.new(0.5, -100, 0.55, 0)
SubText.Size = UDim2.new(0, 200, 0, 30)
SubText.Font = Enum.Font.Gotham
SubText.Text = "Memuat..."
SubText.TextColor3 = Color3.fromRGB(180, 180, 200)
SubText.TextSize = 16
SubText.TextScaled = false

-- ANIMASI LOGO (PULSING SIZE & WARNA)
local TweenService = game:GetService("TweenService")

local originalSize = Logo.Size
local biggerSize = UDim2.new(0, 330, 0, 66)
local originalColor = Logo.TextColor3
local brighterColor = Color3.fromRGB(0, 230, 255)

local tweenInfoUp = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local tweenInfoDown = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.In)

local function animateLogo()
    while LoadingScreen and LoadingScreen.Parent do
        local sizeTweenUp = TweenService:Create(Logo, tweenInfoUp, {Size = biggerSize})
        local colorTweenUp = TweenService:Create(Logo, tweenInfoUp, {TextColor3 = brighterColor})
        sizeTweenUp:Play()
        colorTweenUp:Play()
        wait(0.6)
        
        local sizeTweenDown = TweenService:Create(Logo, tweenInfoDown, {Size = originalSize})
        local colorTweenDown = TweenService:Create(Logo, tweenInfoDown, {TextColor3 = originalColor})
        sizeTweenDown:Play()
        colorTweenDown:Play()
        wait(0.6)
    end
end

coroutine.wrap(animateLogo)()

-- SIMULASI LOADING DENGAN DURASI YANG LEBIH LAMA (4.5 DETIK)
local startTime = tick()
local minLoadTime = 4.5 -- detik

-- Bisa juga menambahkan efek perubahan teks "Memuat..." menjadi "Selesai!"
-- agar pengguna tahu loading hampir selesai (opsional)
local function updateSubText()
    wait(3.2) -- setelah 3.2 detik, ubah teks
    if SubText and SubText.Parent then
        SubText.Text = "Selesai! 🚀"
        SubText.TextColor3 = Color3.fromRGB(0, 230, 200)
    end
end
coroutine.wrap(updateSubText)()

-- Tunggu hingga waktu minimum tercapai
repeat wait() until tick() - startTime >= minLoadTime

-- Hapus loading screen
LoadingScreen:Destroy()

