-- Load WMacLib
local WMacLib = loadstring(game:HttpGetAsync("https://raw.githubusercontent.com/Wicikk/WMacLib/main/WMacLib.lua"))()

-- Variabel untuk auto walk
local autoWalkEnabled = false
local currentTarget = nil
local walkToConnection = nil
local player = game.Players.LocalPlayer

-- Fungsi untuk mencari item drop terdekat (sesuaikan nama item dengan game Slime Rng)
local function getNearestDrop()
    local nearest = nil
    local shortestDistance = math.huge
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    local hrp = character.HumanoidRootPart
    -- Cari semua part di workspace
    for _, v in pairs(workspace:GetDescendants()) do
        -- ⚠️ PERHATIAN: Ganti "Drop" dengan nama item yang benar di game Slime Rng!
        -- Contoh: "Coin", "Gem", "ItemDrop", "SlimeLoot", dll.
        if v:IsA("BasePart") and (v.Name:lower():find("drop") or v.Name:lower():find("item") or v.Name:lower():find("loot")) then
            local distance = (hrp.Position - v.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearest = v
            end
        end
    end
    return nearest
end

-- Fungsi untuk menghentikan auto walk
local function stopAutoWalk()
    autoWalkEnabled = false
    if walkToConnection then
        walkToConnection:Disconnect()
        walkToConnection = nil
    end
    currentTarget = nil
    -- Hentikan karakter
    local character = player.Character
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid:MoveTo(character.HumanoidRootPart.Position)
    end
end

-- Fungsi untuk memulai auto walk
local function startAutoWalk()
    if walkToConnection then 
        walkToConnection:Disconnect() 
    end
    
    walkToConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if not autoWalkEnabled then return end
        
        -- Cek karakter masih ada
        local character = player.Character
        if not character or not character:FindFirstChild("Humanoid") or not character:FindFirstChild("HumanoidRootPart") then
            return
        end
        
        local humanoid = character.Humanoid
        local hrp = character.HumanoidRootPart
        local target = getNearestDrop()
        
        if target and target.Parent and target:IsDescendantOf(workspace) then
            currentTarget = target
            local distance = (hrp.Position - target.Position).Magnitude
            
            if distance > 4 then
                -- Berjalan menuju target
                humanoid:MoveTo(target.Position)
                humanoid.AutoRotate = true
            else
                -- Jika sudah dekat, berhenti sebentar
                humanoid:MoveTo(hrp.Position)
                task.wait(0.3)
            end
        else
            currentTarget = nil
        end
    end)
end

-- Membuat GUI Window
local Window = WMacLib:Window({
    Title = "Slime Rng - Auto Item Drop",
    Subtitle = "Auto walk to nearest drop",
    Size = UDim2.fromOffset(450, 350),
    AcrylicBlur = true,
    ShowUserInfo = true,
    Keybind = Enum.KeyCode.RightControl,
})

-- Membuat Tab
local mainTab = Window:Tab({ Name = "Auto Farm", Icon = "lucide/droplet" })

-- Membuat Section
local mainSection = mainTab:Section({})

-- Header
mainSection:Header({
    Text = "Auto Item Collector"
})

-- Toggle untuk auto walk
local autoWalkToggle = mainSection:Toggle({
    Name = "Auto Walk to Items",
    Default = false,
    Callback = function(value)
        autoWalkEnabled = value
        if autoWalkEnabled then
            startAutoWalk()
            Window:Notify({
                Title = "Auto Walk",
                Description = "Auto walk ENABLED - Looking for items...",
                Lifetime = 3
            })
        else
            stopAutoWalk()
            Window:Notify({
                Title = "Auto Walk",
                Description = "Auto walk DISABLED",
                Lifetime = 3
            })
        end
    end,
})

-- Label untuk status
local statusLabel = mainSection:Label({
    Text = "Status: Idle"
})

-- Label untuk target
local targetLabel = mainSection:Label({
    Text = "Target: None"
})

-- Update status label setiap detik
task.spawn(function()
    while true do
        task.wait(1)
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            statusLabel:SetName("Status: Waiting for character...")
            targetLabel:SetName("Target: None")
        elseif autoWalkEnabled then
            statusLabel:SetName("Status: <font color='rgb(73, 230, 133)'>● Running</font>")
            if currentTarget and currentTarget.Parent then
                local distance = (player.Character.HumanoidRootPart.Position - currentTarget.Position).Magnitude
                targetLabel:SetName("Target: " .. currentTarget.Name .. " | Distance: " .. math.floor(distance) .. " studs")
            else
                targetLabel:SetName("Target: Searching... (no items found)")
            end
        else
            statusLabel:SetName("Status: ● Stopped")
            targetLabel:SetName("Target: None (Disabled)")
        end
    end
end)

-- Divider
mainSection:Divider()

-- Slider untuk kecepatan jalan
local speedSlider = mainSection:Slider({
    Name = "Walk Speed",
    Default = 16,
    Minimum = 10,
    Maximum = 100,
    Precision = 0,
    DisplayMethod = "Value",
    Suffix = "",
    Callback = function(value)
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = value
        end
    end,
})

-- Tombol refresh scan
mainSection:Button({
    Name = "Force Scan Items",
    Callback = function()
        local nearest = getNearestDrop()
        if nearest then
            Window:Notify({
                Title = "Scan Result",
                Description = "Found: " .. nearest.Name .. " at " .. math.floor((player.Character and player.Character.HumanoidRootPart and (nearest.Position - player.Character.HumanoidRootPart.Position).Magnitude or 0)) .. " studs",
                Lifetime = 4
            })
            targetLabel:SetName("Target: " .. nearest.Name)
        else
            Window:Notify({
                Title = "Scan Result",
                Description = "No items found nearby!",
                Lifetime = 3
            })
            targetLabel:SetName("Target: None found")
        end
    end,
})

-- Divider
mainSection:Divider()

-- Informasi cara penggunaan
mainSection:Paragraph({
