-- Function to simulate clicking the roll button
local function clickRollButton()
    -- Locate Roll button - adjust based on actual game UI
    local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    
    -- Common button name guesses
    local possibleButtonNames = {"Roll", "RollButton", "Spin", "AutoRoll", "RollBtn"}
    
    for _, name in pairs(possibleButtonNames) do
        local button = playerGui:FindFirstChild(name, true)
        if button and button:IsA("TextButton") or button:IsA("ImageButton") then
            button:Click()
            return true
        end
    end
    return false
end

-- Function to collect ground items
local function lootNearby()
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Look for items on ground (coins, loot bags, orbs)
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("BasePart") and item:FindFirstChild("BillboardGui") then
            -- Item detection logic would go here
            if (item.Position - hrp.Position).Magnitude < 15 then
                -- Move to item position
                hrp.CFrame = CFrame.new(item.Position)
                wait(0.3)
                -- Simulate touching the part to collect
                firetouchinterest(hrp, item, 0)
                firetouchinterest(hrp, item, 1)
            end
        end
    end
end

-- Function to find and fight nearest enemy
local function fightNearestEnemy()
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Look for enemies (mobs) in workspace
    local nearestEnemy = nil
    local nearestDist = 50
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            if obj.Name:find("Enemy") or obj.Name:find("Mob") or obj.Name:find("Slime") then
                local enemyHrp = obj:FindFirstChild("HumanoidRootPart")
                if enemyHrp and enemyHrp.Position then
                    local dist = (enemyHrp.Position - hrp.Position).Magnitude
                    if dist < nearestDist and dist > 5 then
                        nearestDist = dist
                        nearestEnemy = obj
                    end
                end
            end
        end
    end
    
    if nearestEnemy and nearestEnemy:FindFirstChild("HumanoidRootPart") then
        -- Move to enemy
        hrp.CFrame = CFrame.new(nearestEnemy.HumanoidRootPart.Position)
        wait(0.2)
        -- Auto attack - simulate click on enemy (hitbox)
        local humanoid = nearestEnemy:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 then
            -- Attack logic would go here
        end
    end
end

-- Function to upgrade best owned slime
local function attemptUpgrade()
    -- Look for upgrade button in UI
    local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    local upgradeBtn = playerGui:FindFirstChild("Upgrade", true)
    if upgradeBtn and (upgradeBtn:IsA("TextButton") or upgradeBtn:IsA("ImageButton")) then
        upgradeBtn:Click()
        return true
    end
    return false
end

