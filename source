--[[
    SCRIPT AUTO WALK - SLIME RNG (FIXED)
    Fitur:
    - Auto Walk (berjalan otomatis)
    - Pengaturan Kecepatan (Speed)
    - Pilihan Arah (Forward/Backward/Left/Right)
    - Reset speed saat auto walk dimatikan
--]]

-- Load WindUI Library
local WindUI = loadstring(game:HttpGet('https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/main_example.lua'))()

-- Variabel
local autoWalkEnabled = false
local walkDirection = "Forward"
local walkSpeed = 16
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local currentWalkTask = nil

-- Update character
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
end)

-- Mendapatkan arah gerakan
local function getMoveDirection()
    local camera = workspace.CurrentCamera
    local cf = camera.CFrame
    
    if walkDirection == "Forward" then
        return cf.LookVector
    elseif walkDirection == "Backward" then
        return -cf.LookVector
    elseif walkDirection == "Left" then
        return -cf.RightVector
    elseif walkDirection == "Right" then
        return cf.RightVector
    end
    return Vector3.new(0, 0, 0)
end

-- Berhenti berjalan
local function stopWalking()
    if humanoid then
        humanoid:Move(Vector3.new(0, 0, 0), false)
        humanoid.WalkSpeed = 16 -- Reset kecepatan normal
    end
end

-- Auto walk loop
local function startAutoWalk()
    if currentWalkTask then
        task.cancel(currentWalkTask)
    end
    
    currentWalkTask = task.spawn(function()
        while autoWalkEnabled and humanoid and humanoid.Parent do
            local moveDir = getMoveDirection()
            humanoid:Move(moveDir, true)
            humanoid.WalkSpeed = walkSpeed
            task.wait()
        end
    end)
end

-- Toggle auto walk
local function toggleAutoWalk()
    autoWalkEnabled = not autoWalkEnabled
    
    if autoWalkEnabled then
        startAutoWalk()
    else
        stopWalking()
    end
end

-- Update speed
local function setWalkSpeed(value)
    walkSpeed = value
    if autoWalkEnabled and humanoid then
        humanoid.WalkSpeed = walkSpeed
    end
end

-- UI WINDOW
local MainWindow = WindUI:Window({
    Title = "Slime RNG Auto Walk",
    SubTitle = "Auto Walk Script",
    Icon = "rbxassetid://6031093677"
})

local AutoWalkTab = MainWindow:Tab({
    Title = "Auto Walk"
})

local MainSection = AutoWalkTab:Section({
    Title = "Pengaturan Auto Walk"
})

-- Toggle utama
local autoWalkToggle
autoWalkToggle = MainSection:Toggle({
    Title = "Auto Walk",
    Description = "Aktifkan/Nonaktifkan auto walk",
    Callback = function(state)
        toggleAutoWalk()
    end
})

-- Dropdown arah
MainSection:Dropdown({
    Title = "Arah Jalan",
    Description = "Pilih arah gerakan karakter",
    Values = {"Forward", "Backward", "Left", "Right"},
    Callback = function(value)
        walkDirection = value
    end
})

-- Slider kecepatan
MainSection:Slider({
    Title = "Kecepatan Jalan",
    Description = "Atur kecepatan berjalan (16 = normal)",
    Min = 16,
    Max = 100,
    Default = 16,
    Callback = function(value)
        setWalkSpeed(value)
    end
})

-- Section info
local InfoSection = AutoWalkTab:Section({
    Title = "Informasi"
})

InfoSection:Label({
    Title = "Tekan Insert untuk membuka/tutup UI"
})

InfoSection:Label({
    Title = "Auto Walk akan berjalan sesuai arah kamera"
})

-- Hotkey Insert
local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Insert then
        MainWindow:Toggle()
    end
end)

-- Notifikasi
MainWindow:Notification({
    Title = "Success",
    Description = "Auto Walk Script Loaded! Tekan Insert",
    Duration = 3
})
