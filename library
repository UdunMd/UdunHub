-- ==================== KEY SYSTEM ====================
local KeySystem = {
    -- GANTI KEYNYA DISINI (default: "ICEHUB2024")
    ValidKey = "ICEHUB2024",
    
    -- Fungsi untuk menyimpan key yang sudah divalidasi
    SaveKey = function(key)
        if writefile then
            writefile("IceHub_Key.txt", key)
        end
    end,
    
    -- Fungsi untuk memuat key tersimpan
    LoadKey = function()
        if readfile and isfile and isfile("IceHub_Key.txt") then
            return readfile("IceHub_Key.txt")
        end
        return nil
    end,
    
    -- Fungsi validasi key
    Validate = function(inputKey)
        return inputKey == KeySystem.ValidKey
    end,
    
    -- Cek apakah sudah terautentikasi
    IsAuthenticated = function()
        local savedKey = KeySystem.LoadKey()
        if savedKey and KeySystem.Validate(savedKey) then
            return true
        end
        return false
    end
}

