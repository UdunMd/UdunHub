    -- Fungsi untuk update CanvasSize secara dinamis
    local function updateCanvas()
        task.defer(function()
            if MenuPage and MenuPage.Visible then
                local layout = menuPageLayout
                if layout then
                    MenuPage.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
                end
            end
            if SettingsPage and SettingsPage.Visible then
                local layout = settingsListLayout
                if layout then
                    SettingsPage.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
                end
            end
            for _, page in pairs(activePages) do
                if page ~= MenuPage and page ~= SettingsPage and page.Visible and page:IsA("ScrollingFrame") then
                    local layout = page:FindFirstChildOfClass("UIListLayout")
                    if layout then
                        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
                    end
                end
            end
        end)
    end

    -- Update canvas saat layout berubah
    menuPageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
    settingsListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

    -- Update awal
    task.wait(0.1)
    updateCanvas()

