        end,
        -- Tambahan fungsi untuk Key System
        GetKeySystem = function()
            return KeySystem
        end,
        Reauthenticate = function()
            KeySystem.SaveKey(nil)
            screenGui:Destroy()
            IceHub.CreateMain(gameName, subtitle)
        end
    }
    
    return api
end

