    -- DRAG LOGIC YANG LEBIH BAIK
    local dragging = false
    local dragStartPos = Vector2.new()
    local dragStartFramePos = UDim2.new()
    
    local function updateDrag(input)
        if dragging then
            local delta = input.Position - dragStartPos
            MainFrameShadow.Position = UDim2.new(
                dragStartFramePos.X.Scale, 
                dragStartFramePos.X.Offset + delta.X,
                dragStartFramePos.Y.Scale, 
                dragStartFramePos.Y.Offset + delta.Y
            )
        end
    end
    
    TopFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStartPos = input.Position
            dragStartFramePos = MainFrameShadow.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateDrag(input)
        end
    end)

